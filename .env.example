# Copy to .env and fill in. .env is gitignored.

# LLM providers, tried in this order. Providers without an API key are skipped.
# Known: gemini, openrouter, groq, mistral, cerebras
LLM_PROVIDERS=gemini,openrouter

# Primary: Google Gemini free tier. Key: https://aistudio.google.com/apikey
# Free limits are per project; see https://aistudio.google.com/rate-limit
# One key, or several numbered keys tried in order (_1, _2, ... up to _9).
# Numbered keys win; a plain GEMINI_API_KEY is then ignored.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RPM=10

# Fallback: OpenRouter free models. Key: https://openrouter.ai/keys
# :free limits: 20 RPM, 50 req/day (1000/day after buying $10 of credits once)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional extras (add to LLM_PROVIDERS to use)
# GROQ_API_KEY=         # openai/gpt-oss-120b: 30 RPM, 1K req/day, 8K TPM, 200K tokens/day
# MISTRAL_API_KEY=      # free "Experiment" tier; requires opting in to training on your data
# CEREBRAS_API_KEY=     # trial credits, expire after 30 days

# Override any limit: <PROVIDER>_RPM, <PROVIDER>_TPM, <PROVIDER>_BASE_URL
